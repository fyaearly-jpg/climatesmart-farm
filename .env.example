# Alamat backend Flask (hanya di server, tanpa awalan NEXT_PUBLIC_).
# Dipakai next.config.ts untuk meneruskan /api/v1/* ke backend.
# Lokal: http://localhost:5000
# Production (Vercel): alamat HTTPS publik backend Docker, tanpa garis miring di akhir,
#   contoh https://api.climatesmartfarm.example
# Setelah mengubah nilainya di Vercel, lakukan Redeploy karena dibaca saat build.
BACKEND_URL=http://localhost:5000